{
  "mcpServers": {
    "originkit": {
      "type": "http",
      "url": "https://mcp.originkit.dev/mcp",
      "headers": {
        "Authorization": "Bearer ${ORIGINKIT_API_KEY:-set-in-env}"
      }
    },
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${API_KEY_21ST:-set-in-env}"
      }
    },
    "agentation": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "agentation-mcp@1.3.2", "server"]
    }
  }
}
