---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site, formatPrice, withBase } from "../site.config";
---
<Base
  title="Prezzi · Danamus"
  description="Danamus è gratis: analisi, editor ed export del video completo. Il piano Pro da 5 € al mese è in arrivo."
>
  <Nav />
  <main id="main" class="pt-28 sm:pt-36">
    <div class="container-site">
      <header class="text-center">
        <p class="eyebrow" data-reveal>Prezzi</p>
        <h1 class="text-section mx-auto mt-4 max-w-[14ch] text-balance" data-split>Scegli il piano.</h1>
        <p class="text-lead text-soft mx-auto mt-6 max-w-[40ch] text-pretty" data-reveal style="--reveal-index:2">
          Il piano Free basta per rivedere le tue partite. Pro aggiunge strumenti per chi registra e pubblica tanto.
        </p>
      </header>

      <ul class="mx-auto mt-16 grid max-w-[880px] gap-16 sm:mt-24 sm:grid-cols-2 sm:gap-12" role="list">
        {site.plans.map((plan, i) => (
          <li class="flex flex-col" data-reveal style={`--reveal-index:${i + 2}`} aria-labelledby={`plan-${plan.id}`}>
            <span class="block h-px w-10 bg-accent" aria-hidden="true"></span>
            <div class="mt-5 flex flex-wrap items-center gap-3">
              <h2 id={`plan-${plan.id}`} class="text-step">{plan.name}</h2>
              {plan.status === "soon" && (
                <span class="text-caption rounded-full px-3 py-1 font-medium text-soft" style="box-shadow: inset 0 0 0 1px var(--border)">
                  {site.comingSoonLabel}
                </span>
              )}
            </div>
            <p class="mt-4">
              <span class="text-section tabular">{formatPrice(plan.price)}</span>
              {plan.period && <span class="text-soft ml-2">{plan.period}</span>}
            </p>
            {plan.intro && <p class="text-soft mt-6">{plan.intro}</p>}
            <ul class:list={["grid gap-3", plan.intro ? "mt-3" : "mt-6"]} role="list">
              {plan.features.map((f) => (
                <li class="flex gap-3">
                  <svg class="mt-1 h-4 w-4 flex-none text-accent" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8.5l3 3 7-7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <div class="mt-8">
              {plan.status === "available" ? (
                <a href={withBase("/#scarica")} class="btn-primary">Scarica Danamus</a>
              ) : (
                <span class="btn-soon" aria-label={`${plan.name}: ${site.comingSoonLabel}`}>{site.comingSoonLabel}</span>
              )}
            </div>
          </li>
        ))}
      </ul>

      <div class="text-caption text-muted mx-auto mt-16 grid max-w-[880px] gap-2 sm:mt-20">
        <p>In tutti i piani l'analisi avviene sul tuo dispositivo, e la sua durata dipende molto dal dispositivo che usi.</p>
        <p>Prezzi IVA inclusa.</p>
      </div>
    </div>
  </main>
  <Footer />
</Base>
