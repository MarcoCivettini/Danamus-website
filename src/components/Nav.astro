---
import { withBase } from "../site.config";

// On the landing page section links stay "#id", so motion.ts can smooth-scroll
// them and move focus. On other pages they point back to the landing page.
const home = withBase("/").replace(/\/$/, "");
const onHome = Astro.url.pathname.replace(/\/$/, "") === home;
const section = (id: string) => (onHome ? `#${id}` : withBase(`/#${id}`));

const links = [
  { href: section("come-funziona"), label: "Come funziona" },
  { href: section("per-chi"), label: "Per chi è" },
  { href: withBase("/prezzi/"), label: "Prezzi" },
];
---
<header class="glass fixed inset-x-0 top-0 z-50">
  <nav class="container-site flex h-14 items-center justify-between gap-6" aria-label="Principale">
    <a href={onHome ? "#top" : withBase("/")} class="flex items-center" aria-label={onHome ? "Danamus, torna all'inizio" : "Danamus, pagina principale"}>
      <img src={withBase("brand/danamus-horizontal-reversed.svg")} alt="" width="104" height="26" class="h-[26px] w-auto" />
    </a>
    <ul class="hidden items-center gap-8 md:flex" role="list">
      {links.map((l) => (
        <li><a href={l.href} class="inline-flex min-h-8 items-center px-1 text-caption text-soft transition-colors duration-150 hover:text-fg">{l.label}</a></li>
      ))}
    </ul>
    <a href={section("scarica")} class="btn-primary !min-h-8 !px-4 text-caption">Scarica</a>
  </nav>
</header>
