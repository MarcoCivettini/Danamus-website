---
/**
 * The problem section's main visual: a real match drawn as rallies and pauses,
 * from the curated Danamus project (src/data/demo-project.json, made by
 * `pnpm make:demo`). Static (no JS, reduced motion): two bars, the full
 * recording and the rallies only. With motion, motion.ts hides the second bar
 * and plays a one-off sequence on the first: playhead sweep, pauses fade and
 * close up, the full length stays as a dashed outline (spec: landing-page).
 */
import demo from "../data/demo-project.json";

const total = demo.duration;
type Segment = { kind: "rally" | "pause"; grow: number };
const segments: Segment[] = [];
let cursor = 0;
for (const r of demo.intervals) {
  if (r.start > cursor) segments.push({ kind: "pause", grow: +(r.start - cursor).toFixed(3) });
  segments.push({ kind: "rally", grow: +(r.end - r.start).toFixed(3) });
  cursor = r.end;
}
if (total > cursor) segments.push({ kind: "pause", grow: +(total - cursor).toFixed(3) });

// Rounded to tenths so the static labels and the animated counter agree.
const play = Math.round(demo.intervals.reduce((t, r) => t + (r.end - r.start), 0) * 10) / 10;
const share = (play / total) * 100;
const mss = (s: number) => {
  const r = Math.round(s + 1e-6);
  return `${Math.floor(r / 60)}:${String(r % 60).padStart(2, "0")}`;
};
const words = (s: number) => {
  const m = Math.floor(s / 60);
  const sec = Math.round(s % 60);
  return `${m} ${m === 1 ? "minuto" : "minuti"} e ${sec} secondi`;
};
const rallies = segments.filter((s) => s.kind === "rally");
---
<div class="timeline" data-timeline data-total={total} data-play={play} style={`--play-share: ${share.toFixed(2)}%`}>
  <figure
    class="timeline__figure"
    role="img"
    aria-label={`Una partita vera, ${demo.match}: ${words(total)} di video, ${words(play)} di gioco. Il resto sono pause.`}
  >
    <div class="timeline__row">
      <div class="timeline__meta">
        <span data-timeline-name>La registrazione</span>
        <span class="timeline__value tabular" data-timeline-value>{mss(total)}</span>
      </div>
      <div class="timeline__lane">
        <div class="timeline__ghost" data-timeline-ghost>
          <span class="timeline__removed" data-timeline-removed>−{mss(Math.round(total) - Math.round(play))} di pause</span>
        </div>
        <div class="timeline__track" data-timeline-track>
          {segments.map((s) => (
            <span class={`timeline__seg timeline__seg--${s.kind}`} style={`flex-grow: ${s.grow}`}></span>
          ))}
        </div>
        <span class="timeline__head" data-timeline-head></span>
      </div>
    </div>
    <div class="timeline__row timeline__row--after">
      <div class="timeline__meta">
        <span>Solo il gioco</span>
        <span class="timeline__value tabular">{mss(play)}</span>
      </div>
      <div class="timeline__track timeline__track--play">
        {rallies.map((s) => (
          <span class="timeline__seg timeline__seg--rally" style={`flex-grow: ${s.grow}`}></span>
        ))}
      </div>
    </div>
  </figure>
  <div class="timeline__foot">
    <div class="timeline__legend" aria-hidden="true">
      <span><i class="timeline__dot timeline__dot--rally"></i>Scambi</span>
      <span><i class="timeline__dot timeline__dot--pause"></i>Pause</span>
    </div>
    <button type="button" class="timeline__replay" data-timeline-replay hidden>
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
      Rivedi
    </button>
  </div>
  <p class="timeline__caption">
    Una partita vera: {demo.match}. Il gioco è circa un quarto del video, come in una partita tipica.
  </p>
</div>

<style>
  .timeline { display: grid; gap: 20px; }
  .timeline__figure { margin: 0; display: grid; gap: 28px; }
  .timeline__row { display: grid; gap: 12px; }
  .timeline__meta { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; color: var(--soft); font-size: var(--text-caption); }
  .timeline__value { color: var(--fg); font-weight: 600; font-size: var(--text-lead); }
  .timeline__lane { position: relative; height: clamp(28px, 4vw, 44px); }
  .timeline__track { display: flex; width: 100%; height: clamp(28px, 4vw, 44px); border-radius: 4px; overflow: hidden; }
  .timeline__track--play { width: var(--play-share); }
  .timeline__seg { flex-basis: 0; min-width: 0; }
  /* A hairline in the band colour keeps rallies apart once the pauses are gone. */
  .timeline__seg--rally { background: var(--accent); min-width: 2px; box-shadow: inset -1px 0 0 var(--surface); }
  .timeline__seg--pause { background: var(--border); }
  .timeline__ghost {
    position: absolute; inset: 0; border-radius: 4px; opacity: 0; pointer-events: none;
    background: repeating-linear-gradient(-45deg, transparent 0 6px, rgb(255 255 255 / 0.04) 6px 12px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.22);
  }
  .timeline__removed {
    position: absolute; top: 50%; left: calc(var(--play-share) + 16px); translate: 0 -50%;
    font-size: var(--text-caption); font-weight: 600; color: var(--soft); white-space: nowrap; opacity: 0;
  }
  .timeline__head {
    position: absolute; top: -6px; bottom: -6px; left: 0; width: 2px; translate: -1px 0;
    background: var(--fg); border-radius: 2px; opacity: 0; pointer-events: none;
    box-shadow: 0 0 12px rgb(255 255 255 / 0.6);
  }
  .timeline__foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; }
  .timeline__legend { display: flex; gap: 24px; font-size: var(--text-caption); color: var(--muted); }
  .timeline__legend span { display: inline-flex; align-items: center; gap: 8px; }
  .timeline__dot { width: 10px; height: 10px; border-radius: 2px; display: inline-block; }
  .timeline__dot--rally { background: var(--accent); }
  .timeline__dot--pause { background: var(--border); }
  .timeline__replay {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 999px;
    font-size: var(--text-caption); font-weight: 600; color: var(--fg); box-shadow: inset 0 0 0 1px var(--border);
    cursor: pointer; transition: box-shadow var(--duration-fast) var(--ease-smooth-out);
  }
  .timeline__replay:hover { box-shadow: inset 0 0 0 1px var(--soft); }
  .timeline__replay[hidden] { display: none; }
  .timeline__caption { font-size: var(--text-caption); color: var(--muted); max-width: 60ch; }
  /* With motion the first bar does the compression, so the second is hidden. */
  :global(html.motion-ok) .timeline__row--after { display: none; }
</style>
