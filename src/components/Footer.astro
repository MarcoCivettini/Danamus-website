---
import { withBase } from "../site.config";
const year = new Date().getFullYear();
const links = [
  { href: withBase("/prezzi/"), label: "Prezzi" },
  { href: withBase("/privacy/"), label: "Privacy" },
  { href: withBase("/termini/"), label: "Termini" },
];
---
<footer class="mt-[var(--section-gap)] pb-12">
  <div class="container-site flex flex-col items-start gap-6 border-t border-border pt-8 text-caption text-muted sm:flex-row sm:items-center sm:justify-between">
    <img src={withBase("brand/danamus-horizontal-reversed.svg")} alt="Danamus" width="104" height="26" class="h-[26px] w-auto" />
    <nav aria-label="Informazioni">
      <ul class="flex flex-wrap gap-x-6 gap-y-2" role="list">
        {links.map((l) => (
          <li><a href={l.href} class="inline-flex min-h-6 items-center text-soft underline-offset-4 hover:text-fg hover:underline">{l.label}</a></li>
        ))}
      </ul>
    </nav>
    <p class="tabular">© {year} Danamus</p>
  </div>
</footer>
