---
import DeviceFrame from "../DeviceFrame.astro";
import Screenshot from "../Screenshot.astro";
---
<section id="piattaforme" class="mt-[var(--section-gap)]" aria-labelledby="platforms-title">
  <div class="container-site text-center">
    <p class="eyebrow" data-reveal>Windows · macOS · iOS</p>
    <h2 id="platforms-title" class="text-section mx-auto mt-4 max-w-[16ch] text-balance" data-reveal style="--reveal-index:1">
      Su ogni schermo che usi.
    </h2>
    <p class="text-lead text-soft mx-auto mt-6 max-w-[40ch]" data-reveal style="--reveal-index:2">
      Analizzi la partita al computer e la rivedi sull'iPhone. Stessa app, stesso modo di lavorare.
    </p>
  </div>
  <div class="container-site mt-16 sm:mt-24">
    <ul class="platforms" role="list">
      <li class="platforms__item platforms__item--desktop" data-reveal style="--reveal-index:1">
        <DeviceFrame variant="window" width={2880} height={1800}>
          <Screenshot id="windows-editor" displayWidth={560} sizes="(min-width: 1024px) 42vw, 92vw" />
        </DeviceFrame>
        <p class="text-headline mt-5 font-semibold">Windows</p>
      </li>
      <li class="platforms__item platforms__item--phone" data-reveal style="--reveal-index:2">
        <DeviceFrame variant="phone" width={1206} height={2622}>
          <Screenshot id="ios-editor" displayWidth={260} sizes="260px" />
        </DeviceFrame>
        <p class="text-headline mt-5 font-semibold">iOS</p>
      </li>
      <li class="platforms__item platforms__item--desktop" data-reveal style="--reveal-index:3">
        <DeviceFrame variant="window" width={2880} height={1800}>
          <Screenshot id="macos-editor" displayWidth={560} sizes="(min-width: 1024px) 42vw, 92vw" />
        </DeviceFrame>
        <p class="text-headline mt-5 font-semibold">macOS</p>
      </li>
    </ul>
  </div>
</section>

<style>
  .platforms { display: grid; gap: 64px; text-align: center; }
  .platforms__item--phone { width: min(240px, 64vw); margin-inline: auto; }
  @media (min-width: 1024px) {
    .platforms { grid-template-columns: 1fr minmax(0, 220px) 1fr; align-items: center; gap: clamp(24px, 3vw, 48px); }
    .platforms__item--phone { width: 100%; }
  }
</style>
