---
import DeviceFrame from "../DeviceFrame.astro";
import Screenshot from "../Screenshot.astro";
import Clip from "../Clip.astro";
---
<section id="piattaforme" class="mt-[var(--section-gap)]" aria-labelledby="platforms-title">
  <div class="container-site text-center">
    <p class="eyebrow" data-reveal>iPhone · Mac · Windows</p>
    <h2 id="platforms-title" class="text-section-sm mx-auto mt-4 max-w-[16ch] text-balance" data-split>
      Sul telefono o sul computer.
    </h2>
    <p class="text-lead text-soft mx-auto mt-6 max-w-[40ch]" data-reveal style="--reveal-index:2">
      Puoi fare tutto dal telefono, dalla registrazione all'export. Se preferisci uno schermo grande, Danamus funziona anche su Mac e Windows.
    </p>
  </div>
  <div class="container-site mt-16 sm:mt-24">
    <div class="combo" data-reveal style="--reveal-index:1">
      <div class="combo__desktop">
        <DeviceFrame variant="window" width={1280} height={800}>
          <Clip id="clip-macos-editor" displayWidth={960} />
        </DeviceFrame>
      </div>
      <div class="combo__phone">
        <div data-parallax>
          <DeviceFrame variant="phone" width={1170} height={2532}>
            <Screenshot id="ios-editor" displayWidth={260} sizes="(min-width: 1024px) 260px, 30vw" />
          </DeviceFrame>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* One group: the desktop window with the phone overlapping its bottom-right
     corner. Bottom padding leaves room for the phone hanging below the window. */
  .combo { position: relative; max-width: 1040px; margin-inline: auto; padding-bottom: 14%; }
  .combo__desktop { width: 88%; }
  .combo__phone {
    position: absolute; right: 0; bottom: 0;
    width: 30%;
    filter: drop-shadow(0 30px 60px rgb(0 0 0 / 0.6));
  }
  @media (min-width: 1024px) {
    .combo__phone { width: 24%; }
  }
</style>
