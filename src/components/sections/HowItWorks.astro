---
import DeviceFrame from "../DeviceFrame.astro";
import Screenshot from "../Screenshot.astro";
import Clip from "../Clip.astro";
import type { MediaId } from "../../data/media";

const steps: { title: string; text: string; media: MediaId; clip?: boolean }[] = [
  { title: "Scegli il video", text: "Apri la registrazione della partita dal telefono o dal computer. Il file resta sul tuo dispositivo.", media: "ios-picker" },
  { title: "Segna l'area di gioco", text: "Trascini gli angoli del rettangolo attorno al tavolo: Danamus guarda solo lì e ignora il resto.", media: "ios-area" },
  { title: "L'AI trova gli scambi", text: "Il modello segue la pallina fotogramma per fotogramma e capisce quando si gioca e quando no. Intanto puoi aprire altri progetti.", media: "clip-analysis", clip: true },
  { title: "Correggi a mano, se serve", text: "Ogni scambio è un segmento sulla timeline: lo allunghi, lo accorci o lo scarti. Con annulla e ripristina.", media: "clip-editing", clip: true },
  { title: "Esporta", text: "Ottieni un video con solo il gioco, salvato nel Rullino o sul disco, pronto da rivedere o da condividere.", media: "ios-export" },
];
---
<section id="come-funziona" class="mt-[var(--section-gap)]" aria-labelledby="how-title">
  <div class="container-site">
    <header>
      <p class="eyebrow" data-reveal>Come funziona</p>
      <h2 id="how-title" class="text-section mt-4 max-w-[13ch] text-balance" data-split>
        Dalla partita intera al solo gioco.
      </h2>
    </header>

    <div class="walkthrough mt-16 lg:mt-24" data-walkthrough data-active="0">
      <ol class="walkthrough__steps" role="list" data-steps>
        {steps.map((s, i) => (
          <li class="walkthrough__step" data-step={String(i)}>
            <div data-reveal>
              <p class="text-caption tabular text-accent font-semibold">0{i + 1}</p>
              <h3 class="text-step mt-3">{s.title}</h3>
              <p class="text-lead text-soft mt-4 max-w-[34ch]">{s.text}</p>
            </div>
            <div class="walkthrough__inline mt-8" data-reveal style="--reveal-index:1">
              <DeviceFrame variant="phone" width={720} height={1558}>
                {s.clip ? <Clip id={s.media} displayWidth={300} /> : <Screenshot id={s.media} displayWidth={300} sizes="(min-width: 400px) 300px, 78vw" />}
              </DeviceFrame>
            </div>
          </li>
        ))}
      </ol>
      <div class="walkthrough__stage" aria-hidden="true">
        <div class="walkthrough__sticky">
          <div class="walkthrough__track"><span class="walkthrough__progress" data-walkthrough-progress></span></div>
          <div class="walkthrough__phone">
            <DeviceFrame variant="phone" width={720} height={1558}>
              {steps.map((s, i) => (
                <div class="walkthrough__media" data-media={String(i)}>
                  {s.clip ? <Clip id={s.media} displayWidth={340} /> : <Screenshot id={s.media} displayWidth={340} sizes="340px" />}
                </div>
              ))}
            </DeviceFrame>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Default (no JS or narrow screens): each step shows its own media. */
  .walkthrough__steps { display: grid; gap: clamp(72px, 12vw, 120px); }
  .walkthrough__inline { width: min(300px, 78vw); }
  .walkthrough__stage { display: none; }

  @media (min-width: 1024px) {
    :global(html.js) .walkthrough {
      display: grid;
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: clamp(40px, 5vw, 80px);
    }
    :global(html.js) .walkthrough__steps { gap: 0; }
    :global(html.js) .walkthrough__step {
      min-height: 78vh;
      display: flex; flex-direction: column; justify-content: center;
      opacity: 0.35;
      transition: opacity var(--duration-slow) var(--ease-smooth-out);
    }
    :global(html.js) .walkthrough__step[data-current] { opacity: 1; }
    :global(html.js) .walkthrough__inline { display: none; }
    :global(html.js) .walkthrough__stage { display: block; }
    .walkthrough__sticky { position: sticky; top: 0; height: 100vh; display: flex; align-items: center; justify-content: center; padding-top: 56px; }
    /* Phone fits the viewport height: screen ratio 720/1558 plus bezel. */
    .walkthrough__phone { width: min(340px, calc((100vh - 120px) * 0.43)); }
    /* Without motion the active media simply shows; with motion GSAP
       cross-fades it (inline styles override these rules). */
    .walkthrough__media { position: absolute; inset: 0; opacity: 0; }
    .walkthrough__track {
      position: absolute; left: 0; top: 50%; translate: 0 -50%;
      width: 2px; height: min(320px, 40vh); border-radius: 2px;
      background: rgb(255 255 255 / 0.1); overflow: hidden;
    }
    .walkthrough__progress {
      display: block; width: 100%; height: 100%;
      background: var(--color-accent, #00c573);
      transform-origin: 50% 0; transform: scaleY(0);
    }
    :global(html:not(.motion-ok)) .walkthrough__track { display: none; }
    .walkthrough__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
    .walkthrough[data-active="0"] [data-media="0"],
    .walkthrough[data-active="1"] [data-media="1"],
    .walkthrough[data-active="2"] [data-media="2"],
    .walkthrough[data-active="3"] [data-media="3"],
    .walkthrough[data-active="4"] [data-media="4"] { opacity: 1; }
  }
</style>
