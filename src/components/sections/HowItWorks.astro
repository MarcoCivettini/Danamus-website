---
import Icon, { type IconName } from "../Icon.astro";

const steps: { title: string; text: string; note?: string; icon: IconName }[] = [
  { title: "Scegli il video", text: "Apri la registrazione dal telefono o dal computer. Il file resta dove si trova.", icon: "video" },
  { title: "Segna il tavolo", text: "Trascini gli angoli attorno al tavolo, così l'analisi guarda solo lì e ignora il resto della stanza.", icon: "table" },
  { title: "Danamus trova gli scambi", text: "Il modello segue la pallina fotogramma per fotogramma e separa il gioco dalle pause. Intanto puoi lavorare su altri progetti.", note: "La durata dell'analisi dipende molto dal dispositivo.", icon: "analysis" },
  { title: "Rifinisci a mano", text: "Ogni scambio è un segmento sulla timeline. Lo allunghi se è stato tagliato presto, lo scarti se è una pausa. L'editor è pensato per le partite di ping pong.", icon: "segments" },
  { title: "Esporta", text: "Salvi un video con solo gli scambi, nel Rullino o sul disco, pronto da rivedere o da mandare agli amici.", icon: "download" },
];
---
<section id="come-funziona" class="mt-[var(--section-gap)]" aria-labelledby="how-title">
  <div class="container-site">
    <header class="text-center">
      <p class="eyebrow" data-reveal>Come funziona</p>
      <h2 id="how-title" class="text-section-sm mx-auto mt-4 max-w-[18ch] text-balance" data-split>
        Dal video intero al solo gioco.
      </h2>
      <p class="text-lead text-soft mx-auto mt-6 max-w-[40ch]" data-reveal style="--reveal-index:2">
        Danamus fa quasi tutto da solo. Se vuoi un risultato perfetto, ritocchi i dettagli nell'editor.
      </p>
    </header>

    <ol class="steps mt-16 lg:mt-24" role="list">
      {steps.map((s, i) => (
        <li class="step" data-reveal style={`--reveal-index:${i + 1}`}>
          <div class="step__marker">
            <span class="step__icon"><Icon name={s.icon} /></span>
          </div>
          <div class="step__body">
            <p class="text-caption tabular text-accent font-semibold">0{i + 1}</p>
            <h3 class="text-lead mt-2 font-semibold">{s.title}</h3>
            <p class="text-soft mt-2">{s.text}</p>
            {s.note && <p class="text-caption text-muted mt-3">{s.note}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* Mobile: vertical list, a hairline links the icons on the left. */
  .steps { display: grid; gap: 40px; position: relative; max-width: 560px; margin-inline: auto; }
  .steps::before {
    content: ""; position: absolute; left: 21px; top: 22px; bottom: 22px; width: 1px;
    background: var(--border);
  }
  .step { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 20px; position: relative; }
  .step__icon {
    display: grid; place-items: center; width: 44px; height: 44px; border-radius: 999px;
    color: var(--accent); background: var(--bg);
    box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--accent) 45%, transparent);
  }
  /* Desktop: five columns, the hairline runs across behind the icons. */
  @media (min-width: 1024px) {
    .steps { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 32px; max-width: none; }
    .steps::before { left: 22px; right: calc((100% - 4 * 32px) / 5 - 22px); top: 22px; bottom: auto; width: auto; height: 1px; }
    .step { grid-template-columns: none; gap: 24px; align-content: start; }
  }
</style>
