---
import DeviceFrame from "../DeviceFrame.astro";
import Screenshot from "../Screenshot.astro";
import Clip from "../Clip.astro";
import type { MediaId } from "../../data/media";

const steps: { title: string; text: string; media: MediaId; clip?: boolean }[] = [
  { title: "Scegli il video", text: "Apri la registrazione della partita, anche di ore. Il file resta dove si trova, sul tuo disco.", media: "macos-picker" },
  { title: "Segna l'area di gioco", text: "Indichi il tavolo con pochi clic: Danamus guarda solo lì e ignora tutto il resto.", media: "macos-area" },
  { title: "L'AI trova gli scambi", text: "Il modello segue la pallina fotogramma per fotogramma e capisce quando si gioca e quando no. Lavora sul tuo dispositivo, anche in background.", media: "clip-analysis", clip: true },
  { title: "Correggi a mano, se serve", text: "Ogni scambio è un segmento sulla timeline: lo allunghi, lo accorci o lo scarti. Con annulla e ripristina.", media: "clip-editing", clip: true },
  { title: "Esporta", text: "Ottieni un video con solo il gioco, pronto da rivedere con l'allenatore o da condividere.", media: "macos-export" },
];
---
<section id="come-funziona" class="mt-[var(--section-gap)]" aria-labelledby="how-title">
  <div class="container-site">
    <header>
      <p class="eyebrow" data-reveal>Come funziona</p>
      <h2 id="how-title" class="text-section mt-4 max-w-[13ch] text-balance" data-reveal style="--reveal-index:1">
        Dalla partita intera al solo gioco.
      </h2>
    </header>

    <div class="walkthrough mt-16 lg:mt-24" data-walkthrough data-active="0">
      <ol class="walkthrough__steps" role="list">
        {steps.map((s, i) => (
          <li class="walkthrough__step" data-step={String(i)}>
            <div data-reveal>
              <p class="text-caption tabular text-accent font-semibold">0{i + 1}</p>
              <h3 class="text-step mt-3">{s.title}</h3>
              <p class="text-lead text-soft mt-4 max-w-[34ch]">{s.text}</p>
            </div>
            <div class="walkthrough__inline mt-8" data-reveal style="--reveal-index:1">
              <DeviceFrame variant="window" width={2880} height={1800}>
                {s.clip ? <Clip id={s.media} displayWidth={720} /> : <Screenshot id={s.media} displayWidth={720} sizes="92vw" />}
              </DeviceFrame>
            </div>
          </li>
        ))}
      </ol>
      <div class="walkthrough__stage" aria-hidden="true">
        <div class="walkthrough__sticky">
          <DeviceFrame variant="window" width={2880} height={1800}>
            {steps.map((s, i) => (
              <div class="walkthrough__media" data-media={String(i)}>
                {s.clip ? <Clip id={s.media} displayWidth={720} /> : <Screenshot id={s.media} displayWidth={720} sizes="(min-width: 1200px) 660px, 55vw" />}
              </div>
            ))}
          </DeviceFrame>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Default (no JS or narrow screens): each step shows its own media. */
  .walkthrough__steps { display: grid; gap: clamp(72px, 12vw, 120px); }
  .walkthrough__stage { display: none; }

  @media (min-width: 1024px) {
    :global(html.js) .walkthrough {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(40px, 5vw, 80px);
    }
    :global(html.js) .walkthrough__steps { gap: 0; }
    :global(html.js) .walkthrough__step {
      min-height: 78vh;
      display: flex; flex-direction: column; justify-content: center;
      opacity: 0.35;
      transition: opacity var(--duration-slow) var(--ease-smooth-out);
    }
    :global(html.js) .walkthrough__step[data-current] { opacity: 1; }
    :global(html.js) .walkthrough__inline { display: none; }
    :global(html.js) .walkthrough__stage { display: block; }
    .walkthrough__sticky { position: sticky; top: 0; height: 100vh; display: flex; align-items: center; }
    .walkthrough__sticky > :global(.device) { width: 100%; }
    .walkthrough__media {
      position: absolute; inset: 0;
      opacity: 0; scale: 1.02; filter: blur(var(--blur-medium));
      transition:
        opacity var(--duration-very-slow) var(--ease-in-out),
        scale var(--duration-very-slow) var(--ease-smooth-out),
        filter var(--duration-very-slow) var(--ease-in-out);
    }
    .walkthrough__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
    .walkthrough[data-active="0"] [data-media="0"],
    .walkthrough[data-active="1"] [data-media="1"],
    .walkthrough[data-active="2"] [data-media="2"],
    .walkthrough[data-active="3"] [data-media="3"],
    .walkthrough[data-active="4"] [data-media="4"] { opacity: 1; scale: 1; filter: none; }
  }
</style>
